# ZestPath API
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zestpath?schema=public"
SESSION_SECRET="zestpath-dev-secret-change-me"
CLIENT_URL="http://localhost:5173"

# Google OAuth (optional for local guest-only testing)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Gemini (AI Chef) — keep this on the server only; never expose to Vite/React
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
