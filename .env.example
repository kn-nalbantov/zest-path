# Used by docker compose (copy to .env). Do not commit .env.
FE_PORT=8080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zestpath

NODE_ENV=production
COOKIE_SECURE=false
CLIENT_URL=http://localhost:8080
SESSION_SECRET=zestpath-dev-secret-change-me

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Server only — never VITE_*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
